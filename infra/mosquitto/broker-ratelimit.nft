#!/usr/sbin/nft -f
# Connection-rate limit for the MQTT broker (Mosquitto has no built-in one).
# Load on the broker host:   nft -f infra/mosquitto/broker-ratelimit.nft
# A source opening more than 30 new TLS connections per minute (burst 30) is
# dropped for 5 minutes. DSN still sees the attempts in the broker log.

add table inet dsn_broker
delete table inet dsn_broker
table inet dsn_broker {
  set mqtt_conn_rate {
    type ipv4_addr
    flags dynamic, timeout
    timeout 1m
  }
  set mqtt_blocked {
    type ipv4_addr
    flags dynamic, timeout
    timeout 5m
  }
  chain input {
    type filter hook input priority -5; policy accept;
    tcp dport 8883 ip saddr @mqtt_blocked drop
    tcp dport 8883 ct state new add @mqtt_conn_rate { ip saddr limit rate over 30/minute burst 30 packets } add @mqtt_blocked { ip saddr } drop
  }
}
