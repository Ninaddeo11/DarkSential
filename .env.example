# Darknet Sentinel Nexus - environment configuration.
# Copy to .env and fill in. NEVER commit .env.
# All variables are prefixed DSN_ to avoid collisions.

# --- Runtime -----------------------------------------------------------------
DSN_ENV=development                 # development | test | production
DSN_LOG_LEVEL=INFO                  # DEBUG | INFO | WARNING | ERROR
DSN_LOG_JSON=true                   # structured JSON logs

# Safety switch: when true, NO enforcing action (firewall changes, active
# scans, monitor-mode capture) touches the network. Only logs what it would do.
DSN_DRY_RUN=true

# Run feed adapters against /fixtures instead of the network (fully offline).
DSN_OFFLINE_MODE=true

# --- Identity / crypto ---------------------------------------------------------
# Key for HMAC-SHA256(device MAC). >= 32 bytes. Generate with:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
# Rotating this key changes every stored device ID.
DSN_DEVICE_ID_HMAC_KEY=

# --- API -----------------------------------------------------------------------
DSN_API_HOST=127.0.0.1
DSN_API_PORT=8000
# Comma-separated explicit origins. Wildcards are rejected.
DSN_CORS_ORIGINS=http://localhost:5173

# --- Lab network ---------------------------------------------------------------
# The ONLY network the platform may scan or enforce on.
DSN_LAB_CIDR=192.168.50.0/24
# Hosts that must never be quarantined (gateway, broker, admin workstation).
DSN_PROTECTED_HOSTS=192.168.50.1

# --- Storage -------------------------------------------------------------------
DSN_DATABASE_URL=sqlite:///./data/dsn.sqlite3

# Neo4j (STIX graph). Leave URI empty to disable.
DSN_NEO4J_URI=
DSN_NEO4J_USER=neo4j
DSN_NEO4J_PASSWORD=
# Used by docker-compose for the neo4j container (format user/password).
NEO4J_AUTH=neo4j/change-me-to-a-long-random-password

# --- MQTT ----------------------------------------------------------------------
# Leave host empty to disable.
DSN_MQTT_HOST=
DSN_MQTT_PORT=8883
DSN_MQTT_USERNAME=
DSN_MQTT_PASSWORD=

# --- Threat-intel feeds (Phase 1) -----------------------------------------------
DSN_NVD_API_KEY=
DSN_ABUSECH_AUTH_KEY=
# Generic licensed dark-web intel provider (REST). Leave empty to use mocks only.
DSN_DARKWEB_API_URL=
DSN_DARKWEB_API_KEY=
