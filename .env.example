# Darknet Sentinel Nexus - environment configuration.
# Copy to .env and fill in. NEVER commit .env.
# All variables are prefixed DSN_ to avoid collisions.
#
# Keep comments on their own lines: docker compose treats "KEY=   # text" as the
# literal value "# text" (python-dotenv does not), so inline comments are unsafe.

# --- Runtime -----------------------------------------------------------------
# development | test | production
DSN_ENV=development
# DEBUG | INFO | WARNING | ERROR
DSN_LOG_LEVEL=INFO
# Structured JSON logs (false = plain text).
DSN_LOG_JSON=true

# Safety switch: when true, NO enforcing action (firewall changes, active
# scans, monitor-mode capture) touches the network. Only logs what it would do.
DSN_DRY_RUN=true

# Run feed adapters against /fixtures instead of the network (fully offline).
DSN_OFFLINE_MODE=true

# --- Identity / crypto ---------------------------------------------------------
# Key for HMAC-SHA256(device MAC). >= 32 bytes. Generate with:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
# Rotating this key changes every stored device ID.
DSN_DEVICE_ID_HMAC_KEY=

# --- API -----------------------------------------------------------------------
DSN_API_HOST=127.0.0.1
DSN_API_PORT=8000
# Local Vite API proxy (server-side only; no credentials exposed to the browser).
DSN_API_PROXY=http://127.0.0.1:8000
# lab | hosted. Vercel's API entrypoint forces hosted mode.
DSN_DEPLOYMENT=lab
# Comma-separated explicit origins. Wildcards are rejected.
DSN_CORS_ORIGINS=http://localhost:5173

# --- Lab network ---------------------------------------------------------------
# The ONLY network the platform may scan or enforce on.
DSN_LAB_CIDR=192.168.50.0/24
# Hosts that must never be quarantined (gateway, broker, admin workstation).
DSN_PROTECTED_HOSTS=192.168.50.1

# --- Storage -------------------------------------------------------------------
DSN_DATABASE_URL=sqlite:///./data/dsn.sqlite3

# Neo4j (STIX graph). Leave URI empty to use the in-memory graph (not persistent).
# docker-compose sets the URI to bolt://neo4j:7687 for the backend container.
DSN_NEO4J_URI=
DSN_NEO4J_USER=neo4j
DSN_NEO4J_PASSWORD=change-me-to-a-long-random-password
# Used by docker-compose for the neo4j container (format user/password).
# Must match DSN_NEO4J_USER / DSN_NEO4J_PASSWORD. `make setup` generates both.
NEO4J_AUTH=neo4j/change-me-to-a-long-random-password

# --- MQTT ----------------------------------------------------------------------
# Leave host empty to disable.
DSN_MQTT_HOST=
DSN_MQTT_PORT=8883
DSN_MQTT_USERNAME=
DSN_MQTT_PASSWORD=

# --- Threat-intel feeds (Phase 1) -----------------------------------------------
# Schedules and limits live in backend/config/feeds.yaml.
# Persistent feed scheduler on/off:
DSN_SCHEDULER_ENABLED=true
# Optional overrides (defaults are fine): DSN_FEEDS_CONFIG_PATH, DSN_FIXTURES_DIR,
# DSN_CACHE_DIR (default ./data/cache).
#
# Optional; raises the NVD rate limit:
DSN_NVD_API_KEY=
# Required for URLhaus + ThreatFox live mode (free key at auth.abuse.ch):
DSN_ABUSECH_AUTH_KEY=

# Generic licensed dark-web intel provider (REST/JSON over HTTPS).
# Leave URL empty to use mocks only.
DSN_DARKWEB_API_URL=
DSN_DARKWEB_API_KEY=
DSN_DARKWEB_AUTH_HEADER=Authorization
# Empty scheme sends the bare key in the header.
DSN_DARKWEB_AUTH_SCHEME=Bearer
# Dot path to the list of mentions in the provider's response.
DSN_DARKWEB_ITEMS_PATH=data
# Our field -> provider field (dot paths), JSON. `id` and `text` are required.
DSN_DARKWEB_FIELD_MAP={"id":"id","source":"source","published":"published_at","text":"text"}

# --- Devices & behavior (Phase 2) -------------------------------------------------
# Trust/allowlist: backend/config/devices.yaml. Rules: backend/config/rules.yaml.
# Windows/baselines/score weights: backend/config/behavior.yaml.
#
# Discovery sources (all off by default). Each also needs a runtime capability
# check (see GET /api/discovery/capabilities).
# Active nmap scans of DSN_LAB_CIDR only; they also require DSN_DRY_RUN=false.
DSN_NMAP_ENABLED=false
DSN_NMAP_INTERVAL_MINUTES=30
# Passive ARP/DHCP/mDNS listening (needs root/CAP_NET_RAW, or Npcap on Windows).
DSN_PASSIVE_CAPTURE_ENABLED=false
DSN_PASSIVE_CAPTURE_IFACE=
# Passive BLE advertisement scanning (never connects to devices).
DSN_BLE_SCAN_ENABLED=false
# 802.11 deauth monitoring: Linux monitor-mode iface, root, and DSN_DRY_RUN=false.
DSN_WIFI_MONITOR_ENABLED=false
DSN_WIFI_MONITOR_IFACE=
# Isolation Forest: trained from simulated normal traffic at startup if no valid
# signed model exists in DSN_MODELS_DIR (default ./data/models).
DSN_IFOREST_AUTOTRAIN=true

# --- Explainable risk (Phase 3) -----------------------------------------------------
# Weights / thresholds / actions: backend/config/risk.yaml (weights must sum to 1).
# XGBoost + SHAP comparison model (never changes decisions); trained at startup
# from simulated data if no valid signed model exists. Needs the `ml` extra.
DSN_XGB_AUTOTRAIN=true

# --- Response: quarantine / recovery (Phase 4) ------------------------------------------
# Firewall driver when DSN_DRY_RUN=false: nftables (preferred) | iptables | dryrun.
# Real enforcement also needs the gateway deployment (infra/docker-compose.gateway.yml).
DSN_RESPONSE_DRIVER=nftables
# Quarantine automatically when the risk engine recommends it (CRITICAL).
DSN_AUTO_QUARANTINE=true
DSN_QUARANTINE_MINUTES=30
# Refuse to hold more than this many quarantines at once (poisoned-intel guard).
DSN_MAX_ACTIVE_QUARANTINES=10
# After an operator releases a device, automatic quarantine of it pauses this
# long (the human decision wins). An automatic expiry doesn't pause it.
DSN_OPERATOR_RELEASE_GRACE_MINUTES=30
# --- Dashboard / API auth (Phase 6) ---------------------------------------------
# POST /api/auth/login exchanges these long-lived secrets (>= 32 chars) for short-lived
# session tokens signed with DSN_AUTH_JWT_SECRET. make setup generates all three.
# ADMIN -> role operator (quarantine/release/approve); VIEWER -> read-only.
DSN_AUTH_JWT_SECRET=
DSN_ADMIN_TOKEN=
DSN_VIEWER_TOKEN=
DSN_AUTH_SESSION_MINUTES=60
# Require a token for reads too (REST + live events). Empty = production only.
DSN_AUTH_READS=
# Optional OIDC resource-server mode (all three together; https only). Tokens with
# DSN_OIDC_OPERATOR_ROLE in DSN_OIDC_ROLES_CLAIM are operators, others viewers.
DSN_OIDC_ISSUER=
DSN_OIDC_AUDIENCE=
DSN_OIDC_JWKS_URL=
DSN_OIDC_ROLES_CLAIM=roles
DSN_OIDC_OPERATOR_ROLE=dsn-operator
# Per-client rate limits (requests/minute); health probes are exempt.
DSN_RATE_LIMIT_READS_PER_MINUTE=600
DSN_RATE_LIMIT_MUTATIONS_PER_MINUTE=30
DSN_RATE_LIMIT_LOGINS_PER_MINUTE=10
# MQTT client TLS + the key that signs commands to the (virtual) status node (>= 32 chars).
DSN_MQTT_TLS=true
DSN_MQTT_CA_FILE=
DSN_MQTT_COMMAND_KEY=
# Mosquitto log the backend tails for CONNECT / auth-failure / SUBSCRIBE / denied-PUBLISH
# events (set automatically in docker-compose). Empty -> telemetry-only traffic events.
DSN_MQTT_BROKER_LOG=
# MQTT users whose own broker activity is not device behavior (CSV).
DSN_MQTT_SERVICE_CLIENTS=dsn-backend
# Host interface the broker port is published on (docker-compose). The virtual lab
# reaches the broker on its internal network; the default keeps it local-only.
DSN_MQTT_BIND=127.0.0.1
